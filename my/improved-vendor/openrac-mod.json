{
  "format": 2,
  "version": "0.1.0",
  "author": "mo",
  "license": "GPL-3.0-or-later",
  "api": "1.9",
  "games": {
    "rac1": [
      "pal",
      "ntsc"
    ]
  },
  "id": "improved-vendor",
  "name": "Improved Vendor",
  "description": "Adds lightweight vendor feedback: current wallet on vendor open and a clear acquisition notice after item purchases.",
  "hooks": [
    "rac1.vendor.build_item_list",
    "rac1.item.give"
  ],
  "settings": [
    {
      "key": "show_wallet",
      "name": "Show bolts when vendor opens",
      "type": "bool",
      "default": true
    },
    {
      "key": "purchase_notice",
      "name": "Show purchase/acquisition notice",
      "type": "bool",
      "default": true
    }
  ]
}
